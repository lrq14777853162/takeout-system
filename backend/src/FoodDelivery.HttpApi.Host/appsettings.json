{
  "App": {
    "SelfUrl": "http://localhost:5000",
    "CorsOrigins": "http://localhost:3000,http://localhost:8080"
  },
  "AuthServer": {
    "Authority": "http://localhost:5000",
    "RequireHttpsMetadata": "false",
    "SwaggerClientId": "FoodDelivery_Swagger"
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=food_delivery;User Id=root;Password=yourpassword;CharSet=utf8mb4;"
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "UserName": "guest",
    "Password": "guest"
  },
  "Jwt": {
    "Secret": "YourSuperSecretKeyForJwtTokenGeneration32Chars!!",
    "Issuer": "FoodDelivery",
    "Audience": "FoodDelivery",
    "ExpirationInMinutes": 1440
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
